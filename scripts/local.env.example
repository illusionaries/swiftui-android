# scripts/local.env — personal toolchain paths, never committed.
#
# Copy to scripts/local.env and fill in what `scripts/env.sh --check` reports as missing.
# Every value is optional: env.sh already finds the standard install locations, so this file
# is only for checkouts where the toolchain lives somewhere unusual. Values here are plain
# shell assignments, sourced before the build scripts run.
#
# scripts/local.env is in .gitignore — keep it that way. Publishing a file with your home
# directory in it is exactly what this mechanism exists to prevent.

# ── the OSS Swift toolchain (the one the Swift SDK for Android was built with) ──
# Any of these layouts works: a toolchain root, an .xctoolchain, or an unpacked .pkg's
# Payload directory (the one that contains usr/bin/swift).
# SWIFT_TOOLCHAIN="$HOME/Library/Developer/Toolchains/swift-6.4.3-RELEASE.xctoolchain"
# SWIFT_TOOLCHAIN="$HOME/.swiftly/toolchains/swift-6.4.3-RELEASE"
# SWIFT_TOOLCHAIN=/path/to/unpacked-swift-6.4.3-package.pkg/Payload   # holds usr/bin/swift

# ── the Swift SDK for Android (…/swift-<ver>_android.artifactbundle/swift-android) ──
# SWIFT_ANDROID_SDK="$HOME/Library/org.swift.swiftpm/swift-sdks/swift-6.4.3-RELEASE_android.artifactbundle/swift-android"

# ── the Android SDK, and an NDK r27+ inside or outside it ──
# ANDROID_HOME="$HOME/Library/Android/sdk"
# ANDROID_NDK_HOME="$ANDROID_HOME/ndk/30.0.14904162"

# ── the JDK used for javac/d8/apksigner/keytool (21 preferred, 17+ works) ──
# JAVA_HOME=/opt/homebrew/opt/openjdk@21

# ── optional: pin the device the scripts talk to ──
# ANDROID_SERIAL=emulator-5554          # any serial `adb devices` prints
